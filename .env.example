# Database
KORTEX_DATABASE_URL=postgresql+asyncpg://kortex:kortex@localhost:5432/kortex

# Redis (Celery broker + rate limit)
KORTEX_REDIS_URL=redis://localhost:6379/0

# S3 / MinIO
KORTEX_S3_ENDPOINT_URL=http://localhost:9000
KORTEX_S3_REGION=us-east-1
KORTEX_S3_BUCKET=kortex-attachments
KORTEX_S3_ACCESS_KEY=minioadmin
KORTEX_S3_SECRET_KEY=minioadmin
KORTEX_S3_USE_SSL=false

# Auth
KORTEX_JWT_SECRET=replace-with-random-32-byte-base64
KORTEX_JWT_ALGORITHM=HS512
KORTEX_JWT_ACCESS_TTL_SECONDS=3600
KORTEX_JWT_REFRESH_TTL_SECONDS=2592000

# Embeddings
KORTEX_EMBEDDER=local_bge
KORTEX_EMBEDDER_MODEL=BAAI/bge-large-en-v1.5
KORTEX_EMBEDDER_DIM=1024

# LLM
KORTEX_LLM_PROVIDER=anthropic
KORTEX_LLM_MODEL_PLANNER=claude-sonnet-4-7
KORTEX_LLM_MODEL_SUMMARIZER=claude-haiku-4-5
ANTHROPIC_API_KEY=

# Retrieval
KORTEX_AGENTIC_RETRIEVAL=true
KORTEX_RETRIEVAL_MAX_HOPS=3
KORTEX_RETRIEVAL_MAX_CANDIDATES=200

# Telemetry
KORTEX_OTEL_ENABLED=false
KORTEX_OTEL_ENDPOINT=http://localhost:4317
KORTEX_OTEL_SERVICE_NAME=kortex
KORTEX_LOG_LEVEL=INFO
KORTEX_LOG_JSON=true

# Email — "log" (dev, prints links to logs) or "smtp" (real delivery).
KORTEX_EMAIL_BACKEND=log
KORTEX_EMAIL_FROM=no-reply@kortex.dev
KORTEX_WEB_BASE_URL=http://localhost:5173
KORTEX_SMTP_HOST=localhost
KORTEX_SMTP_PORT=587
KORTEX_SMTP_USER=
KORTEX_SMTP_PASSWORD=
KORTEX_SMTP_STARTTLS=true

# Billing (Stripe) — optional. Unset = billing runs in preview (checkout disabled).
KORTEX_STRIPE_SECRET_KEY=
KORTEX_STRIPE_WEBHOOK_SECRET=
KORTEX_STRIPE_PRICE_PRO=
KORTEX_STRIPE_PRICE_TEAM=
KORTEX_BILLING_SUCCESS_URL=http://localhost:5173/app/billing?checkout=success
KORTEX_BILLING_CANCEL_URL=http://localhost:5173/app/billing?checkout=cancel

# API
KORTEX_API_HOST=0.0.0.0
KORTEX_API_PORT=8000
# Web SPA origin (kortex-web dev server). Add prod origin(s) when deploying.
KORTEX_API_CORS_ORIGINS=http://localhost:5173

# Environment
KORTEX_ENV=development

# ---------------------------------------------------------------------------
# Governance — all on by default. Every one of these was invisible here until
# someone tried to configure it, so they are listed with their real defaults.
# ---------------------------------------------------------------------------

# Fold a repeat write into the existing memory instead of storing a rival copy.
KORTEX_DEDUP_ON_WRITE=true

# Surface memories that contradict each other at recall time. Costs one LLM
# call per candidate pair; turn off if you have no LLM configured.
KORTEX_CONFLICT_DETECTION=true

# Scan writes for personal data. `tag` records what was found, `redact` removes
# it, `escalate` raises the memory's sensitivity instead.
KORTEX_PII_DETECTION=true
KORTEX_PII_POLICY=tag

# Hold low-trust content that reads as instructions to a model, and keep
# low-trust memories out of confidential/secret recalls.
KORTEX_INJECTION_QUARANTINE=true
KORTEX_TRUST_FILTERING=true

# Confidence below which a project in `low_confidence` review mode holds a
# write for a human. Review mode itself is per project, not an env var.
KORTEX_REVIEW_CONFIDENCE_THRESHOLD=0.5

# Delete audit entries older than N days. 0 disables retention entirely, which
# is the default — deleting compliance evidence should be a decision, not a
# default. The purge writes its own audit entry saying how many went.
KORTEX_AUDIT_RETENTION_DAYS=0

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------

# Let an LLM plan multi-hop retrieval. Falls back to plain hybrid when no LLM
# is reachable, so leaving this on without a key is safe.
KORTEX_AGENTIC_RETRIEVAL=true
KORTEX_RETRIEVAL_DEFAULT_MAX_TOKENS=4000
KORTEX_RETRIEVAL_TOP_K_VECTOR=50
KORTEX_RETRIEVAL_TOP_K_BM25=50

# Per-model token prices, so recall can report what it spent. Without this
# `usage.cost_usd` is null — which means unpriced, not free.
# KORTEX_LLM_PRICES={"claude-opus-5":[5.0,25.0]}

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# `s3` (MinIO in dev) or `fs` for a plain directory — the one-container image
# uses fs, which is why it needs no MinIO.
KORTEX_STORAGE_BACKEND=s3
# KORTEX_FS_STORAGE_ROOT=/data/attachments

# ---------------------------------------------------------------------------
# Rate limits (per API key, per minute)
# ---------------------------------------------------------------------------
KORTEX_RATE_LIMIT_READ_PER_MIN=600
KORTEX_RATE_LIMIT_WRITE_PER_MIN=120
KORTEX_RATE_LIMIT_RECALL_PER_MIN=60
