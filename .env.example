# Database
KORTEX_DATABASE_URL=postgresql+asyncpg://kortex:kortex@localhost:5432/kortex

# Redis (Celery broker + rate limit)
KORTEX_REDIS_URL=redis://localhost:6379/0

# S3 / MinIO
KORTEX_S3_ENDPOINT_URL=http://localhost:9000
KORTEX_S3_REGION=us-east-1
KORTEX_S3_BUCKET=kortex-attachments
KORTEX_S3_ACCESS_KEY=minioadmin
KORTEX_S3_SECRET_KEY=minioadmin
KORTEX_S3_USE_SSL=false

# Auth
KORTEX_JWT_SECRET=replace-with-random-32-byte-base64
KORTEX_JWT_ALGORITHM=HS512
KORTEX_JWT_ACCESS_TTL_SECONDS=3600
KORTEX_JWT_REFRESH_TTL_SECONDS=2592000

# Embeddings
KORTEX_EMBEDDER=local_bge
KORTEX_EMBEDDER_MODEL=BAAI/bge-large-en-v1.5
KORTEX_EMBEDDER_DIM=1024

# LLM
KORTEX_LLM_PROVIDER=anthropic
KORTEX_LLM_MODEL_PLANNER=claude-sonnet-4-7
KORTEX_LLM_MODEL_SUMMARIZER=claude-haiku-4-5
ANTHROPIC_API_KEY=

# Retrieval
KORTEX_AGENTIC_RETRIEVAL=true
KORTEX_RETRIEVAL_MAX_HOPS=3
KORTEX_RETRIEVAL_MAX_CANDIDATES=200

# Telemetry
KORTEX_OTEL_ENABLED=false
KORTEX_OTEL_ENDPOINT=http://localhost:4317
KORTEX_OTEL_SERVICE_NAME=kortex
KORTEX_LOG_LEVEL=INFO
KORTEX_LOG_JSON=true

# API
KORTEX_API_HOST=0.0.0.0
KORTEX_API_PORT=8000
KORTEX_API_CORS_ORIGINS=http://localhost:3000

# Environment
KORTEX_ENV=development
